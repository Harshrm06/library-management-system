# ---------------------------------------------------------------------------
# Library Management System - Frontend environment template
#
# Setup:
#   1. Copy this file and fill in your own values:
#        cp .env.example .env.local     (Windows: copy .env.example .env.local)
#   2. Point VITE_API_BASE_URL at your backend (default: http://localhost:8000)
#   3. Install dependencies and start the dev server:
#        npm install
#        npm run dev
#
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# Never commit the resulting .env.local file - it is ignored by git.
# ---------------------------------------------------------------------------

VITE_API_BASE_URL=http://localhost:8000
VITE_APP_NAME=Library Management System
VITE_APP_ENV=development