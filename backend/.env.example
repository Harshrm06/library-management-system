
# ---------------------------------------------------------------------------
# Library Management System - Backend environment template
#
# Setup:
#   1. Create the database:
#        CREATE DATABASE library_db;
#   2. Copy this file and fill in your own values:
#        cp .env.example .env          (Windows: copy .env.example .env)
#   3. Generate a JWT secret:
#        python -c "import secrets; print(secrets.token_urlsafe(48))"
#   4. Install dependencies:
#        pip install -r requirements.txt
#   5. Run the API:
#        uvicorn app.main:app --reload
#
# Never commit the resulting .env file - it is ignored by git.
# ---------------------------------------------------------------------------


# Database Configuration
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/library_db
MYSQL_USER=root
MYSQL_PASSWORD=password
MYSQL_HOST=localhost
MYSQL_DATABASE=library_db

# JWT Configuration
JWT_SECRET=your_super_secret_key_change_in_production_12345
JWT_SECRET=your_secret_key_here_change_in_production
JWT_EXPIRY_HOURS=24
ALGORITHM=HS256

# Server Configuration
SERVER_HOST=localhost
SERVER_PORT=8000
DEBUG=True
DEBUG=True

# CORS (comma-separated list of allowed origins; React dev server default)
CORS_ORIGINS=http://localhost:3000

# Logging
LOG_LEVEL=INFO
