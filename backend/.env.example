# ---------------------------------------------------------------------------
# Library Management System - Backend environment template
#
# Setup:
#   1. Create the MySQL database:
#        CREATE DATABASE library_db;
#   2. Copy this file and fill in your own values:
#        cp .env.example .env          (Windows: copy .env.example .env)
#   3. Generate a JWT secret:
#        python -c "import secrets; print(secrets.token_urlsafe(48))"
#   4. Install dependencies:
#        pip install -r requirements.txt
#   5. Apply migrations and run the server:
#        alembic upgrade head
#        uvicorn app.main:app --reload
#
# Never commit the resulting .env file - it is ignored by git.
# ---------------------------------------------------------------------------

# Database Configuration
DATABASE_URL=mysql+pymysql://root:CHANGE_ME@localhost:3306/library_db
MYSQL_USER=root
MYSQL_PASSWORD=CHANGE_ME
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=library_db

# JWT Configuration
JWT_SECRET=CHANGE_ME_generate_a_long_random_secret
JWT_EXPIRY_HOURS=24
ALGORITHM=HS256

# Server Configuration
SERVER_HOST=localhost
SERVER_PORT=8000
DEBUG=True

# CORS (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:5173

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Business Rules
BORROW_DAYS=14
FINE_PER_DAY=1.00