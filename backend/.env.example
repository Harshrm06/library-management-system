# ---------------------------------------------------------------------------
# Library Management System - Backend environment template
#
# Setup:
#   1. Copy this file to .env            (Windows: copy .env.example .env)
#   2. Generate a real JWT secret:
#        python -c "import secrets; print(secrets.token_urlsafe(48))"
#   3. Install dependencies:
#        pip install -r requirements.txt
#   4. Create the schema and seed data:
#        python seed_data.py
#   5. Run the API:
#        uvicorn app.main:app --reload
#
# Never commit the resulting .env file - it is ignored by git.
# ---------------------------------------------------------------------------

# Database
# Defaults to a SQLite file in the backend directory, so no server is needed.
# MySQL also works; install the drivers and use, for example:
#   DATABASE_URL=mysql+pymysql://root:password@localhost:3306/library_db
DATABASE_URL=sqlite:///./library_db.db

# JWT Configuration
# Replace this placeholder with a generated secret before deploying.
JWT_SECRET=replace_me_with_secrets_token_urlsafe_48
JWT_EXPIRY_HOURS=24
ALGORITHM=HS256
JWT_ISSUER=library-management-system

# Server Configuration
SERVER_HOST=localhost
SERVER_PORT=8000
DEBUG=False

# CORS - comma-separated origins allowed to call the API from a browser.
# The variable name must be CORS_ORIGINS: that is the settings field.
# `cors_origin_list` is only a derived property, so setting a variable by that
# name has no effect - unknown variables are ignored, not rejected.
# 5173 is the Vite dev server port configured in frontend/vite.config.js.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Logging
LOG_LEVEL=INFO
